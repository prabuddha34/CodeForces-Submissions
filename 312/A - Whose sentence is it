#include <bits/stdc++.h>
using namespace std;
 
int main() {
    int n;
    cin >> n;
    cin.ignore();
 
    while(n--) {
        string s;
        getline(cin, s);
 
        bool rainbow = false;
        bool freda = false;
 
        if(s.size() >= 5) {
            if(s.substr(0, 5) == "miao.")
                rainbow = true;
 
            if(s.substr(s.size() - 5) == "lala.")
                freda = true;
        }
 
        if(rainbow && !freda)
            cout << "Rainbow's" << endl;
        else if(freda && !rainbow)
            cout << "Freda's" << endl;
        else
            cout << "OMG>.< I don't know!" << endl;
    }
 
    return 0;
}