 
import java.util.Scanner;
 
 
public class Main{
 
  public static void main(String[] args) {
  Scanner sc=new Scanner(System.in);
  int n=sc.nextInt();
  int arr[]=new int[n];
  for(int i=0;i<n;i++){
    arr[i]=sc.nextInt();
  }
  int sum=0;
  for(int i=0;i<n;i++){
  sum=0;
  while(arr[i] !=0){
    int rem=arr[i]%10;
    sum=sum+rem;
    arr[i]=arr[i]/10;
  }
  System.out.println(sum);
    
  }
   sc.close();
  }
}