import  java.io.*;
import java.util.Scanner;
 
public class Main {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);
        int n = input.nextInt();
        long a[]=new long[n];
        long b[]=new long[n];
        boolean isChanged=false;
        for(int i=0;i<n;i++){
            a[i]=input.nextLong();
            b[i]=input.nextLong();
            if(a[i]!=b[i]){
                isChanged=true;
            }
 
        }
        boolean isStart=true;
        for (int i = 0; i < n - 1; i++) {
            if (a[i] < a[i + 1]) {
                isStart = false;
            }
        }
 
        if (isChanged) {
            System.out.println("rated");
        } else if (!isStart) {
            System.out.println("unrated");
        } else {
            System.out.println("maybe");
        }
    }
 
 
    }