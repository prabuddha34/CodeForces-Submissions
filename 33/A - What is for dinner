#include <bits/stdc++.h>
using namespace std;
 
int main() {
    int n, m;
    long long k;
    cin >> n >> m >> k;
 
    vector<long long> rowMin(m + 1, LLONG_MAX);
 
    for(int i = 0; i < n; i++) {
        int r;
        long long c;
        cin >> r >> c;
 
        rowMin[r] = min(rowMin[r], c);
    }
 
    long long total = 0;
 
    for(int i = 1; i <= m; i++) {
        total += rowMin[i];
    }
 
    cout << min(total, k) << endl;
 
    return 0;
}