#include <bits/stdc++.h>
using namespace std;
 
int main() {
    int n, m;
    cin >> n >> m;
 
    int l = 1, r = n;
 
    for (int i = 0; i < m; i++) {
        string s1, s2, dir, s4;
        int x;
 
        cin >> s1 >> s2 >> dir >> s4 >> x;
 
        if (dir == "left") {
            r = min(r, x - 1);
        } else {
            l = max(l, x + 1);
        }
    }
 
    if (l > r) {
        cout << -1;
    } else {
        cout << r - l + 1;
    }
 
    return 0;
}